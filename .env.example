# StartupOS environment configuration
# Copy this file to .env.local and fill in your values. Never commit .env.local.
#
# Accounts and saved businesses REQUIRE the database and auth settings below;
# a production server refuses to start, listing the missing variable names, if they are unset.
# AI and search keys are optional: generation falls back to the built-in
# deterministic engine and upgrades to live LLM generation when a key is present.

# --- Database (PostgreSQL) — REQUIRED ---
# Any PostgreSQL 14+ connection string (Neon, Supabase, RDS, local, ...).
# For local development, `npm run db:local` starts an embedded server and prints
# a URL to use here. Apply migrations with `npm run db:migrate`.
DATABASE_URL=

# --- Authentication (Better Auth) — REQUIRED ---
# Random secret used to sign sessions, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Public base URL of the app (e.g. https://app.example.com). Optional in local
# development; REQUIRED in production, where the server refuses to start without it.
# Local tip: use http://localhost:3000. Opening the app at http://127.0.0.1:3000 is
# also accepted automatically. If Next.js falls back to another port (e.g. :3001
# when :3000 is busy), same-origin mutations from that port are still allowed;
# prefer matching BETTER_AUTH_URL to the URL you actually open in the browser.
# Extra origins can be listed (comma-separated) as:
# BETTER_AUTH_TRUSTED_ORIGINS=https://preview.example.com
BETTER_AUTH_URL=
# Optional public origin used for absolute published website URLs. Falls back to
# BETTER_AUTH_URL when unset. If set, it must be a full URL including https://.
APP_ORIGIN=
# Optional comma-separated extra trusted origins for Better Auth (preview URLs, etc.).
# BETTER_AUTH_TRUSTED_ORIGINS=

# --- Password recovery email (optional; required for “Forgot password”) ---
# Uses Resend's HTTPS API. Without both values, the forgot-password UI explains that
# recovery is unavailable (no fake success). Never commit real keys.
# EMAIL_FROM=StartupOS <onboarding@resend.dev>
# RESEND_API_KEY=re_...
# Local/tests: NODE_ENV=test (or EMAIL_TEST_SINK=1) captures messages in-memory.

# --- Google Sign-In (optional) ---
# Create an OAuth 2.0 Web client in Google Cloud Console. Authorized redirect URI:
#   {BETTER_AUTH_URL}/api/auth/callback/google
# Examples:
#   http://localhost:3000/api/auth/callback/google
#   https://your-domain.com/api/auth/callback/google
# Both values are required; the secret must never be exposed to the browser.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Generation rate limits (optional) ---
# Per-user requests allowed per rolling hour window for paid operations. Counters
# live in PostgreSQL, so every app instance shares them. Values must be whole
# numbers from 1 to 10000; unset or invalid values use the defaults shown.
# Limits cannot be disabled. If the database is unavailable, these requests fail with 503.
RATE_LIMIT_GENERATE_PER_HOUR=10
RATE_LIMIT_REGENERATE_PER_HOUR=30
RATE_LIMIT_RESEARCH_PER_HOUR=20

# --- LLM provider (OpenAI-compatible chat completions) ---
# OpenAI is the intended primary provider. A real OPENAI_API_KEY (sk-…) wins over
# a leftover local OPENAI_BASE_URL in auto mode — set LLM_PROVIDER to opt into Ollama.
#
# LLM_PROVIDER=auto          (default) OpenAI key → OpenAI; else Ollama cloud/local
# LLM_PROVIDER=openai        require OpenAI; refuse silent Ollama / deterministic as "AI"
# LLM_PROVIDER=ollama-local  force local Ollama (dev only; refused in production)
# LLM_PROVIDER=ollama-cloud  force Ollama Cloud (needs OLLAMA_API_KEY)
# LLM_PROVIDER=auto
#
# A) OpenAI (paid credits) — quality-first defaults
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-6.1-sol
# If OPENAI_MODEL is still an Ollama tag (e.g. gemma3:1b) while a real sk- key is
# set, StartupOS remaps to gpt-6.1-sol so api.openai.com is not called with a local ID.
#
# B) Ollama Cloud — only when you intentionally prefer it (no real sk- OpenAI key,
#    or LLM_PROVIDER=ollama-cloud). Create a key at https://ollama.com/settings/keys.
# OLLAMA_API_KEY=
# OPENAI_BASE_URL=https://ollama.com/v1
# OPENAI_MODEL=gemma4:31b
#
# C) Ollama Local — development only; set LLM_PROVIDER=ollama-local if you also
#    have an OpenAI key and still want local inference. Production refuses localhost.
# Pull first: `ollama pull gemma3:1b`
# LLM_PROVIDER=ollama-local
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=gemma3:1b
#
# Shared (leave blank until you pick A/B/C):
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OLLAMA_API_KEY=
LLM_PROVIDER=

# --- Task-aware chat routing (OpenAI only) ---
# Default: quality — route by task on OpenAI:
#   reasoning → gpt-6-astra (fallback gpt-6.1-sol)
#   research / creative / website → gpt-6.1-sol (fallback gpt-6-astra)
#   structured → gpt-6-luna (fallback gpt-6.1-sol; Luna is NOT used for complex tasks)
# GPT-6 Chat Completions get task-aware reasoning_effort (high/medium/none).
# Never switches providers: Ollama Cloud/Local keep OPENAI_MODEL.
# Compatibility: OPENAI_MODEL_ROUTING=single forces every agent onto OPENAI_MODEL.
# OPENAI_MODEL_ROUTING=quality
# OPENAI_MODEL_ROUTING=single
# Optional per-task overrides (win over routing when set):
# OPENAI_MODEL_REASONING=gpt-6-astra
# OPENAI_MODEL_RESEARCH=gpt-6.1-sol
# OPENAI_MODEL_CREATIVE=gpt-6.1-sol
# OPENAI_MODEL_WEBSITE=gpt-6.1-sol
# OPENAI_MODEL_STRUCTURED=gpt-6-luna

# --- Logo / brand image generation ---
# Logos need a real OpenAI image endpoint (setup A above). Ollama chat models
# cannot produce PNG logos; Ollama image generation is unavailable on Windows.
# Without OpenAI images, the Logo Agent reports unavailable — never a fake logo.
# gpt-image-1 was shut down 2026-10-23; StartupOS remaps it to Sunburst if set.
# Premium default: gpt-image-2.5-sunburst (high quality). Drafts may use Flare.
# Leave unset to use defaults (Sunburst premium / Flare drafts). Setting OPENAI_IMAGE_MODEL
# only affects premium tasks — drafts always use Flare unless OPENAI_IMAGE_MODEL_DRAFT is set.
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_MODEL_DRAFT=gpt-image-2.5-flare

# --- Live web search (REQUIRED for real competitor & market research) ---
# The Competitor and Market Research agents perform REAL web searches.
# Configure ANY ONE provider below (auto-selected by priority Tavily > Serper > Brave).
# Without a key, those sections report "unavailable" instead of fabricating data.

# Tavily — https://tavily.com (recommended; built for AI)
TAVILY_API_KEY=
# Serper.dev — https://serper.dev (Google search results)
SERPER_API_KEY=
# Brave Search API — https://brave.com/search/api/
BRAVE_API_KEY=

# --- Operations (optional) ---
# Build identifier reported by /api/health, e.g. the release commit SHA.
APP_VERSION=
