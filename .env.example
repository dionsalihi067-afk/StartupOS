# StartupOS environment configuration
# Copy this file to .env.local and fill in your keys.
# The platform runs fully WITHOUT keys using the built-in deterministic engine,
# and automatically upgrades to live LLM generation when a key is present.

# --- LLM provider (OpenAI-compatible chat completions) ---
# Works with OpenAI, OpenRouter, Together, Groq, local LLMs, etc.
OPENAI_API_KEY=
# Override base URL for OpenAI-compatible providers (optional)
# e.g. https://openrouter.ai/api/v1  |  https://api.groq.com/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Model used for text generation
OPENAI_MODEL=gpt-4o-mini

# --- Logo image generation ---
# The Logo Agent generates a REAL, unique logo + app icon for every startup via
# OpenAI image generation (uses OPENAI_API_KEY above). Override the model here.
# Without an API key, the Logo Agent reports an explicit unavailable state and
# never substitutes a placeholder logo.
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Live web search (REQUIRED for real competitor & market research) ---
# The Competitor and Market Research agents perform REAL web searches.
# Configure ANY ONE provider below (auto-selected by priority Tavily > Serper > Brave).
# Without a key, those sections report "unavailable" instead of fabricating data.

# Tavily — https://tavily.com (recommended; built for AI)
TAVILY_API_KEY=
# Serper.dev — https://serper.dev (Google search results)
SERPER_API_KEY=
# Brave Search API — https://brave.com/search/api/
BRAVE_API_KEY=
